datasource db {
    provider = "mysql"
}

generator client {
    provider     = "prisma-client"
    output       = "../../src/generated/prisma"
    moduleFormat = "cjs"
}

model Article {
    articleId String @id @default(uuid(7)) @db.Char(40)

    title       String  @unique
    description String?
    body        String

    published Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
