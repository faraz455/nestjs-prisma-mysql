# Copy this file to .env. .env is gitignored. Do not commit it.
#
# DATABASE_URL is for the Prisma CLI and `yarn data:reset` only.
# The API does not read it. Each host's database is in env.conf.
# `yarn data:reset` deletes every application row in this database
# and inserts sample test data. Skip it when the database holds data
# you need to keep.
#
# Replace JWT_SECRET and AUTH_COOKIE_SECRET before any shared or
# production use. These values match the local quick start.
#
# PRODUCTION=0 mounts Swagger and leaves the Secure cookie flag off
# so a browser on http://localhost can store the session cookies.
# Any other value sets Secure and leaves Swagger unmounted.

DATABASE_URL=mysql://root:1234@localhost:3306/nestdb
LOG_QUERIES=0
LOG_REQUESTS=1

PRODUCTION=0
TIMEZONE=0

JWT_SECRET=secret
AUTH_COOKIE_SECRET=mycookiesecret
