# Copy this file to env.conf. env.conf is gitignored. Do not commit it.
#
# The section name is the Host header, for example localhost:3000.
# An unknown host is 404 Tenant not found.
# Copy a section for each extra host and point it at that tenant's database.
#
# REFRESH_COOKIE_NAME is required. Login sets the refresh cookie under
# that name, and logout and token refresh read it.
# DATA_STORAGE_ROOT is read at startup. The current request path does not use it.
# DB_PASSWORD is a local sample, the same value as the README quick start.
# Replace it before any shared or production database.

[localhost:3000]

AUTH_COOKIE_NAME=_qa_
REFRESH_COOKIE_NAME=_refresh_

DATA_STORAGE_ROOT=./storage

# DATABASE
DB_HOST_MAIN=localhost:3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=nestdb
